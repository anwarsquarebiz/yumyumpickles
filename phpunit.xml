<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The local PHP build has no pdo_sqlite driver, so tests run against
             a dedicated MySQL database. Create it with:
             php database/bootstrap-databases.php -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="medstoyourdoors_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="SHOP_CACHE_ENABLED" value="false"/>
        <env name="SHOP_FETCH_EXCHANGE_RATES" value="false"/>
        <env name="SHOP_DETECT_CURRENCY_FROM_IP" value="false"/>
        <env name="PAYMENT_GATEWAY" value="fake"/>
        <env name="PAYMENT_WEBHOOK_API_KEY" value="testing-webhook-key"/>
        <env name="PAYMENT_GATEWAY_API_KEY" value="testing-api-key"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
